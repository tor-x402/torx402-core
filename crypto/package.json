{
  "name": "@torx402/core",
  "version": "0.1.0",
  "description": "torx402 core cryptographic utilities and shared types",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "mocha --require ts-node/register 'test/*.test.ts' --timeout 60000",
    "test:watch": "mocha --require ts-node/register 'test/**/*.test.ts' --watch --watch-extensions ts",
    "test:coverage": "nyc mocha --require ts-node/register 'test/**/*.test.ts'",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "ffjavascript": "^0.2.60"
  },
  "peerDependencies": {
    "ethers": "^6.9.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.10",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chai": "^4.3.10",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "tornado",
    "x402",
    "privacy",
    "zero-knowledge",
    "cryptography",
    "pedersen",
    "mimc",
    "bn128"
  ],
  "author": "torx402 contributors",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/torx402/torx402-core.git",
    "directory": "crypto"
  },
  "bugs": {
    "url": "https://github.com/torx402/torx402-core/issues"
  },
  "homepage": "https://github.com/torx402/torx402-core/tree/main/crypto#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
