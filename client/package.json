{
  "name": "@torx402/client",
  "version": "0.1.0",
  "description": "torx402 TypeScript client library for privacy-preserving micropayments",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "mocha --require ts-node/register 'test/**/*.test.ts' --timeout 60000",
    "test:watch": "mocha --require ts-node/register 'test/**/*.test.ts' --watch --watch-extensions ts",
    "test:coverage": "nyc mocha --require ts-node/register 'test/**/*.test.ts'",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'examples/**/*.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.9.0",
    "ffjavascript": "^0.2.60",
    "snarkjs": "^0.7.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.10",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chai": "^4.3.10",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "tornado",
    "x402",
    "privacy",
    "zero-knowledge",
    "zk-snark",
    "micropayments",
    "ethereum",
    "web3"
  ],
  "author": "torx402 contributors",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/torx402/torx402-core.git",
    "directory": "client"
  },
  "bugs": {
    "url": "https://github.com/torx402/torx402-core/issues"
  },
  "homepage": "https://github.com/torx402/torx402-core/tree/main/client#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
