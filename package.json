{
  "name": "torx402-core",
  "version": "0.1.0",
  "description": "Privacy-preserving HTTP micropayment protocol - Core implementation",
  "private": true,
  "workspaces": [
    "contracts",
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build:circuits && npm run build:contracts && npm run build:client && npm run build:server",
    "build:circuits": "cd circuits && npm run build",
    "build:contracts": "cd contracts && npm run compile",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "test": "npm run test:contracts && npm run test:client",
    "test:contracts": "cd contracts && npm run test",
    "test:client": "cd client && npm run test",
    "deploy:testnet": "cd contracts && npm run deploy:base-sepolia",
    "setup": "npm run setup:circuits && npm install",
    "setup:circuits": "cd circuits && npm run setup",
    "clean": "npm run clean:circuits && npm run clean:contracts",
    "clean:circuits": "cd circuits && npm run clean",
    "clean:contracts": "cd contracts && npm run clean",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,sol}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,sol}\"",
    "code:check": "npm run lint && npm run format:check",
    "code:fix": "npm run lint:fix && npm run format",
    "prepare": "husky"
  },
  "keywords": [
    "tornado",
    "x402",
    "privacy",
    "micropayments",
    "zero-knowledge",
    "zk-snark",
    "ethereum",
    "web3"
  ],
  "author": "torx402 contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/torx402/torx402-core.git"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^1.2.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.sol": [
      "prettier --write"
    ]
  }
}
