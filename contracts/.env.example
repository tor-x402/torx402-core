# torx402-core - Contracts Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Deployment Private Key
# ============================================
# IMPORTANT: Never commit your actual private key!
# Use a dedicated wallet for testnet deployments
# Export from MetaMask: Account Details > Export Private Key
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ============================================
# RPC Endpoints
# ============================================

# Base Sepolia (Primary Testnet)
# Get free RPC: https://www.alchemy.com or https://www.infura.io
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Or use Alchemy: https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Arbitrum Sepolia (Alternative Testnet)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Ethereum Sepolia (L1 Testnet)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Or use Infura: https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Local Development
LOCALHOST_RPC_URL=http://127.0.0.1:8545

# ============================================
# Block Explorer API Keys (for contract verification)
# ============================================

# BaseScan (for Base Sepolia)
# Get from: https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key_here

# Arbiscan (for Arbitrum Sepolia)
# Get from: https://arbiscan.io/apis
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Etherscan (for Ethereum Sepolia)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============================================
# Gas Reporting (Optional)
# ============================================

# Enable gas reporting (true/false)
REPORT_GAS=false

# CoinMarketCap API key for USD gas estimates
# Get from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=

# Output gas report to file (optional)
# REPORT_GAS_FILE=gas-report.txt

# ============================================
# Deployment Configuration
# ============================================

# Pool denomination in wei (default: 0.001 ETH = 1000000000000000)
POOL_DENOMINATION=1000000000000000

# Merkle tree height (default: 32)
MERKLE_TREE_HEIGHT=32

# ============================================
# Testing Configuration
# ============================================

# Run tests with coverage
COVERAGE=false

# Mocha timeout (ms)
MOCHA_TIMEOUT=300000
